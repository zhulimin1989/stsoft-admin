# Production contract for admin-api and admin-web.
# admin-api owns only ruidong_admin and talks to user/billing through APIs.

NODE_ENV=production
APP_ENV=production
RUIDONG_SERVICE=admin-api
ADMIN_PORT=3001
PORT=3001
ADMIN_DATABASE_URL=postgresql://user:password@postgres:5432/ruidong_admin?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

JWT_SECRET=replace_with_64_random_chars
COOKIE_SECRET=replace_with_64_random_chars
CORS_ORIGINS=https://admin.example.com

# Internal API endpoints and caller-specific credentials.
# ADMIN_TO_BILLING_* must match billing-api; ADMIN_TO_USER_* must match user-api.
USER_SERVICE_URL=http://user-api:3000/api/internal/user/admin
BILLING_SERVICE_URL=http://billing-api:3010/api/internal/billing/admin
BILLING_PORTAL_SERVICE_URL=http://billing-api:3010/api
# Keep this below the outer gateway timeout and above Billing's overview computation budget.
FINANCE_REPORT_REQUEST_TIMEOUT_MS=30000
INTERNAL_BILLS_LIST_TIMEOUT_MS=60000
ADMIN_TO_BILLING_TOKEN=replace_with_64_random_chars
ADMIN_TO_BILLING_CONTEXT_SECRET=replace_with_64_random_chars
ADMIN_TO_USER_TOKEN=replace_with_64_random_chars
ADMIN_TO_USER_CONTEXT_SECRET=replace_with_64_random_chars
BILLING_INTERNAL_API_VERSION=2026-05-16
BILLING_PLATFORM_CURRENCY=usd

SYNC_TOKEN=replace_with_64_random_chars
CODESPHERE_SAAS_BASE_URL=https://saas.example.com

METRICS_USER=prometheus
METRICS_PASSWORD=replace_with_metrics_password
SENTRY_DSN=
SENTRY_RELEASE=
GIT_COMMIT_SHA=

# Build-time public frontend variables. These are safe to expose in browser JS.
VITE_APP_ENV=production
VITE_SENTRY_DSN=
VITE_GIT_COMMIT_SHA=
VITE_PLATFORM_CURRENCY=usd
