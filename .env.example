# === Database ===
ADMIN_DATABASE_URL="postgresql://ruidong_admin:ruidong_admin_dev@localhost:5434/ruidong_admin?schema=public"

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ruidong_dev

# === JWT ===
JWT_SECRET=replace_with_64_hex_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECRET=replace_with_64_hex_chars

# === App ===
# admin API 端口（user API 本地占 3000）
ADMIN_PORT=3000
APP_ENV=development
# admin API 的写操作 Origin 守卫白名单（缺省回退 CORS_ORIGINS；本地 admin web 跑 5175）
ADMIN_CORS_ORIGINS=http://localhost:5175
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# admin web vite dev 代理目标（apps/admin/vite.config.ts，缺省 http://localhost:3001）
# ADMIN_API_PROXY_TARGET=http://localhost:3001

# === User service split ===
# 用户域数据读写一律走 user 服务 internal API（严禁直连 ruidong_console 库）。
# authConfig/oauthConfig 下发（系统设置 → 身份认证）与用户列表查询都经此地址；
# admin-api 使用 ADMIN_TO_USER_* 与 user 服务进行调用方鉴权和管理员上下文签名。
USER_SERVICE_URL=http://localhost:3000/api/internal/user/admin
ADMIN_TO_USER_TOKEN=replace_with_64_hex_chars
ADMIN_TO_USER_CONTEXT_SECRET=replace_with_64_hex_chars

# === Billing service split ===
# admin-api 使用 ADMIN_TO_BILLING_* 与 billing 服务进行调用方鉴权和管理员上下文签名。
BILLING_SERVICE_URL=http://localhost:3010/api/internal/billing/admin
BILLING_PORTAL_SERVICE_URL=http://localhost:3010/api
# Finance overview/details have a bounded budget separate from the 10s global internal timeout.
FINANCE_REPORT_REQUEST_TIMEOUT_MS=30000
# Enterprise bill list GET can scan large token_usage accounts; keep under the public 60s gateway.
INTERNAL_BILLS_LIST_TIMEOUT_MS=60000
ADMIN_TO_BILLING_TOKEN=replace_with_64_hex_chars
ADMIN_TO_BILLING_CONTEXT_SECRET=replace_with_64_hex_chars
BILLING_INTERNAL_API_VERSION=2026-05-16
BILLING_INTERNAL_ACCEPTED_API_VERSIONS=
BILLING_PLATFORM_CURRENCY=usd
# Streaming download timeout from admin-api to billing-api (30 minutes).
FINANCE_EXPORT_DOWNLOAD_TIMEOUT_MS=1800000

# === Encryption ===
ENCRYPTION_KEY=your-32-byte-hex-key-here

# === API Key Hashing ===
# Downstream key_hash is sha256(raw_key). This secret is only used to
# validate legacy HMAC-hashed keys created before the gateway alignment.
API_KEY_HASH_SECRET=replace_with_64_hex_chars

# === Email (Mailpit for dev) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# === SaaS 同步 ===
# 共享密钥，用于 Webhook 推送和同步 API 认证
# 必须与 SaaS 后端的 ADMIN_SYNC_TOKEN 一致
# 生成方式：openssl rand -hex 32
SYNC_TOKEN=changeme_shared_sync_secret

# SaaS Agent Core 观测面板读取地址；admin API 会用 SYNC_TOKEN 代理请求
CODESPHERE_SAAS_BASE_URL=https://saas-test.codesphere.run

# HMAC-SHA256 密钥，用于签名发往 codesphere-saas 的 webhook 请求
# SaaS 端按相同 secret 校验 X-Webhook-Signature：
#   hex(hmac_sha256(secret, "${X-Webhook-Timestamp}.${raw_body}"))
# 可接受的请求时间戳窗口：±300s
# 未设置时回退到 SYNC_TOKEN（但建议单独设置）
# 生成方式：openssl rand -hex 32
SYNC_WEBHOOK_SECRET=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DB_CONNECTION=Username-Password-Authentication

# === Sentry (错误与性能监控) ===
# 当前为可选字段：未设置则 Sentry 禁用（no-op），不阻塞启动。
# 选定观测方案（Sentry SaaS / GlitchTip / 其他）后再填充，
# 并考虑在 assert-production-secrets.ts 将 required 改回 true。
# DSN 格式：https://<public_key>@<host>/<project_id>
SENTRY_DSN=
# 可选：覆盖自动识别的 release（默认用 GIT_COMMIT_SHA）
SENTRY_RELEASE=
# 通常由 CI 注入，关联 Sentry issue 与 commit
GIT_COMMIT_SHA=

# 前端 Sentry（注入到 Vite build，VITE_ 前缀会暴露给浏览器）
VITE_SENTRY_DSN=
VITE_APP_ENV=development
VITE_GIT_COMMIT_SHA=
VITE_PLATFORM_CURRENCY=usd

# Sentry sourcemap 上传（仅 CI 用）
# admin / web 通常分两个 project，SENTRY_PROJECT 在各自 build job 里覆盖
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# === Prometheus /metrics scrape credentials ===
# 未设置时：开发环境允许匿名访问，production 拒绝全部请求
# prod 必须设置，建议在 Prometheus scrape config 用 basic_auth
METRICS_USER=
METRICS_PASSWORD=
