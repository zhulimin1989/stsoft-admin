FROM node:22-alpine AS build
ARG VITE_BASE=/
ARG VITE_PLATFORM_CURRENCY
ARG VITE_BILLING_CURRENCY
# 用户端平台地址(邀请裂变落地页默认值来源);缺省时代码 fallback 到 window.location.origin(=admin 域名,错误)
ARG VITE_USER_APP_URL
# 国内构建:corepack 拉 pnpm 本体、pnpm 拉依赖都走 npmmirror,避开默认 npmjs 跨境慢/抖。
# 海外构建仍用 Dockerfile.web(默认 npmjs)。
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com \
    npm_config_registry=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@12.23.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/admin/package.json apps/admin/
RUN pnpm install --frozen-lockfile --prod=false
COPY packages/shared packages/shared
COPY apps/admin apps/admin
RUN pnpm --filter @ruidong/shared build
RUN cd apps/admin && \
    if [ -n "$VITE_PLATFORM_CURRENCY" ]; then export VITE_PLATFORM_CURRENCY; fi; \
    if [ -n "$VITE_BILLING_CURRENCY" ]; then export VITE_BILLING_CURRENCY; fi; \
    if [ -n "$VITE_USER_APP_URL" ]; then export VITE_USER_APP_URL; fi; \
    pnpm exec tsc -b && pnpm exec vite build --base=${VITE_BASE}

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html
EXPOSE 8080
