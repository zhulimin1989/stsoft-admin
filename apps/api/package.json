{
  "name": "@ruidong/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --entryFile admin-main",
    "dev:admin": "nest start --watch --entryFile admin-main",
    "start": "node dist/admin-main",
    "start:admin": "node dist/admin-main",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/admin-main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:migrate": "prisma migrate dev --schema prisma/admin/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/admin/schema.prisma",
    "prisma:migrate:admin:deploy": "prisma migrate deploy --schema prisma/admin/schema.prisma",
    "prisma:migrate:prod": "prisma migrate deploy --schema prisma/admin/schema.prisma",
    "prisma:migrate:billing": "sh -c 'echo \"codesphere-admin does not own ruidong_billing migrations; run billing migrations from codesphere-billing/apps/api.\" >&2; exit 1'",
    "prisma:seed": "ts-node prisma/admin/seed.ts",
    "prisma:bootstrap:prod": "ts-node prisma/admin/prod-bootstrap.ts",
    "prisma:seed:legacy": "sh -c 'echo \"Legacy console seed is disabled in codesphere-admin. Run owning service seeds from codesphere-user, or run prisma:seed:admin for ruidong_admin.\" >&2; exit 1'",
    "prisma:seed:admin": "ts-node prisma/admin/seed.ts",
    "prisma:studio": "prisma studio --schema prisma/admin/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/admin/schema.prisma",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "^6.0.0",
    "@ruidong/shared": "workspace:*",
    "@sentry/nestjs": "^10.49.0",
    "@sentry/profiling-node": "^10.49.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.24.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node",
            "allowJs": true,
            "esModuleInterop": true,
            "emitDecoratorMetadata": true,
            "experimentalDecorators": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.dto.ts",
      "!**/main.ts",
      "!**/*.module.ts",
      "!**/index.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 45,
        "functions": 30,
        "lines": 48,
        "statements": 48
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@ruidong/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
    }
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  }
}
